{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug chessboard_producer",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/out/chessboard_producer",
            "args": ["--device", "/dev/video10"],
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "cmake: build (Debug)"
        },
        {
            "name": "Debug face_detect",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/out/face_detect",
            "args": ["--device", "/dev/video10"],
            "cwd": "${workspaceFolder}/out",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "cmake: build (Debug)"
        }
    ]
}
